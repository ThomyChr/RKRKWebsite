  "kmz_package": {
    "de_name": "WPML-Routendatei",
    "de_help": "Eine KMZ-Datei ist ein ZIP-Archiv. Dateinamen muessen exakt so heissen, sonst liest Pilot 2 die Route nicht.",
    "suffix": ".kmz",
    "layout": [
      {
        "path": "wpmz/template.kml",
        "de_name": "Vorlagendatei",
        "de_help": "Geschaefts- und Editierparameter. Pilot 2 und FlightHub erzeugen daraus die ausfuehrbare Route."
      },
      {
        "path": "wpmz/waylines.wpml",
        "de_name": "Ausfuehrungsdatei",
        "de_help": "Konkrete Flug- und Payload-Befehle. templateId verknuepft Vorlage und Ausfuehrung."
      },
      {
        "path": "wpmz/res/",
        "de_name": "Ressourcenordner",
        "de_help": "Optional. Hilfsdateien z. B. fuer AI Spot-Check. Fuer Feldscan nicht noetig."
      }
    ]
  },
