        },
        {
          "wpml": "toPointAndStopWithContinuityCurvature",
          "de": "Gekruemmte Route. Fluggeraet stoppt",
          "de_help": "Kurvenflug, haelt am Wegpunkt.",
          "path_mode": "curve",
          "use_straight_line": 0,
