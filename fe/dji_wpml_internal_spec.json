        {
          "wpml": "pointToPoint",
          "de": "Direkt zur Startposition fliegen",
          "de_help": "Nach Erreichen der sicheren Starthoehe Schraegflug zum ersten Wegpunkt.",
          "aliases": ["direkt", "pointtopoint", "schraeg"]
        }
      ]
