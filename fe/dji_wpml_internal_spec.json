      "type": "enum",
      "required": true,
      "settings_key": "end_action",
      "form": "msEndAction",
      "values": [
        {
          "wpml": "noAction",
          "de": "Aufgabe beenden",
          "de_help": "Routenmodus verlassen, keine weitere Aktion.",
          "default": true,
          "aliases": ["beenden", "aufheben", "noaction"],
          "match_contains": ["beenden", "aufheben"]
        },
        {
          "wpml": "goHome",
          "de": "Rückkehr zum Start (RTH)",
          "de_help": "Routenmodus verlassen und zum Startpunkt zurueckfliegen.",
          "aliases": ["rth", "home", "rueckkehr", "rückkehr"],
          "match_contains": ["rth", "home", "rueckkehr", "rückkehr", "startpunkt"]
        },
        {
          "wpml": "autoLand",
          "de": "Landen",
          "de_help": "Routenmodus verlassen und vor Ort landen.",
          "aliases": ["autoland", "landing"],
          "match_contains": ["land"]
