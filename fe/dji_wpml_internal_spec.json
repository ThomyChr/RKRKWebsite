    "wpml:gimbalPitchMode": {
      "de_name": "Gimbalsteuerung",
      "de_help": "Pitch waehrend des Segments zwischen zwei Wegpunkten.",
      "parent": "Folder",
      "files": ["template.kml"],
      "type": "enum",
      "required": true,
      "settings_key": "gimbal_mode",
      "form": "msGimbalMode",
      "values": [
        {
          "wpml": "manual",
          "de": "Manuell",
          "de_help": "Pilot steuert den Pitch. JSON djiPilot2.gimbalControl manuel und gimbalAngle -90. wpml:gimbalPitchAngle wird nicht geschrieben.",
          "default": true,
          "aliases": ["manuell"],
          "match_contains": ["manuel"]
        },
        {
          "wpml": "usePointSetting",
          "de": "Jeden Wegpunkt festlegen",
          "de_help": "Flag Neigungswinkel setzen schaltet nur den Pitch frei und rechnet den Flugpfad nicht neu. JSON djiPilot2.gimbalControl setEachWaypoint und gimbalAngle je Wegpunkt, -90 bis 30. KMZ wpml:gimbalPitchMode usePointSetting und wpml:gimbalPitchAngle. Flag aus: gimbalPitchMode manual, kein gimbalPitchAngle.",
          "aliases": ["usepointsetting"],
          "match_contains": ["wegpunkt", "punkt", "usepoint"]
        }
      ]
    },
    "wpml:waypointHeadingMode": {
      "de_name": "Gierrichtung des Fluggeraetes",
      "de_help": "KMZ-Namen sind nicht die JSON-Namen. followWayline bleibt followWayline. Definiert (JSON customised) ist smoothTransition. Schwenkachse (JSON fixed) bleibt fixed, ohne Winkel. Fokus POI (JSON smoothTransition) ist towardPOI mit waypointPoiPoint.",
      "parent": "wpml:globalWaypointHeadingParam / wpml:waypointHeadingParam",
      "files": ["template.kml", "waylines.wpml"],
      "type": "enum",
      "required": true,
      "settings_key": "heading_mode",
      "form": "msHeadingMode",
      "values": [
        {
          "wpml": "manually",
          "de": "Manuell",
          "de_help": "Nasenrichtung waehrend des Segments manuell steuerbar.",
          "default": true,
          "aliases": ["manuell"],
          "match_contains": ["manuel"]
        },
        {
          "wpml": "followWayline",
          "de": "Richtung zum naechsten Wegpunkt",
          "de_help": "Nase folgt der Kursrichtung zum naechsten Wegpunkt.",
          "aliases": ["followwayline", "flugroute"],
          "match_contains": ["richtung", "flugroute", "followwayline"]
        },
        {
          "wpml": "fixed",
          "de": "Schenkachse sperren",
          "de_help": "JSON yawDirection fixed. Winkel gesperrt, rotes X, kein waypointHeadingAngle.",
          "aliases": ["fixed", "lock"],
          "match_contains": ["schenk", "schwenk"]
        },
        {
          "wpml": "towardPOI",
          "de": "Fokus POI",
          "de_help": "JSON yawDirection smoothTransition. Mit POI: towardPOI und waypointPoiPoint Breite,Laenge,Hoehe. Ohne POI kein towardPOI, dann followWayline, kein erfundener Winkel.",
          "aliases": ["towardpoi"],
          "match_contains": ["poi", "fokus"],
          "extra": { "wpml:waypointPoiPoint": true }
        },
        {
          "wpml": "smoothTransition",
          "de": "Definiert",
          "de_help": "JSON yawDirection customised. Der Richtungswinkel ist die Gierrichtung. waypointHeadingAngle nur wenn direction gesetzt ist, sonst leer, nicht 0. waypointHeadingYawPathMode aus alignmentAircraft.",
          "aliases": ["customised", "customized"],
          "match_contains": ["definiert"],
          "extra": { "wpml:waypointHeadingAngle": true }
        }
      ]
    },
    "wpml:waypointHeadingPathMode": {
